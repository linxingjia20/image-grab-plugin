{
  "manifest_version": 3,
  "name": "电商图片采集助手",
  "version": "1.0.0",
  "description": "在淘宝、天猫、京东、拼多多商品详情页一键采集图片，支持懒加载与背景图，并可批量下载为 PNG。",
  "minimum_chrome_version": "102",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "*://*.taobao.com/*",
    "*://*.tmall.com/*",
    "*://*.jd.com/*",
    "*://*.jd.hk/*",
    "*://*.pinduoduo.com/*",
    "*://*.yangkeduo.com/*",
    "*://*.alicdn.com/*",
    "*://*.taobaocdn.com/*",
    "*://*.tbcdn.cn/*",
    "*://*.360buyimg.com/*",
    "*://*.jdimg.com/*",
    "*://*.pddpic.com/*"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "打开图片采集图库",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.taobao.com/*",
        "*://*.tmall.com/*",
        "*://*.jd.com/*",
        "*://*.jd.hk/*",
        "*://*.pinduoduo.com/*",
        "*://*.yangkeduo.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content.css"
      ],
      "matches": [
        "*://*.taobao.com/*",
        "*://*.tmall.com/*",
        "*://*.jd.com/*",
        "*://*.jd.hk/*",
        "*://*.pinduoduo.com/*",
        "*://*.yangkeduo.com/*"
      ]
    }
  ]
}
